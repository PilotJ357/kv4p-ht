<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!--
	No data is collected: the app makes no network requests and has no
	analytics or third-party SDKs. APRS beacons and messages go out over
	amateur radio (not to the developer or a partner), speech recognition
	is on-device only, and everything else stays in on-device storage.
	-->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- Settings, memories and APRS config read/written by this app only. -->
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
